# Copy to .env.local and fill in. Never commit real values.

# Routing provider: "transitland" (current) or "motis" (self-hosted, later).
ROUTING_PROVIDER=transitland

# Transitland API key (server-side only). Get one at https://www.transit.land
TRANSITLAND_API_KEY=

# Base URL of the self-hosted MOTIS instance. Only used when ROUTING_PROVIDER=motis.
MOTIS_BASE_URL=

# PostHog project token (starts with phc_, from Project settings > Project token)
# and the ingestion host for your region (https://us.i.posthog.com or
# https://eu.i.posthog.com). Copied into the browser bundle, so never put a
# secret (phs_) or personal (phx_) key here; the build drops anything that is
# not phc_. Setup and dashboards: docs/analytics.md.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Upstash Redis REST credentials (server-side only), used for caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
