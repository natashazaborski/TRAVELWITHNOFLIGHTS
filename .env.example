# Copy to .env.local and fill in. Never commit real values.

# Routing provider: "transitland" (current) or "motis" (self-hosted, later).
ROUTING_PROVIDER=transitland

# Transitland API key (server-side only). Get one at https://www.transit.land
TRANSITLAND_API_KEY=

# Base URL of the self-hosted MOTIS instance. Only used when ROUTING_PROVIDER=motis.
MOTIS_BASE_URL=

# PostHog project key and API host, from your PostHog project settings.
# Exposed to the browser. City-level analytics only (CLAUDE.md rule 8).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Upstash Redis REST credentials (server-side only), used for caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
